{
  "scenario": "01-unix-socket",
  "kind": "LIVE_DOCKER",
  "description": "nginx + local PHP-FPM over Unix socket; matching listen endpoint",
  "packages_expected_on_scan_fs": ["nginx configs", "php-fpm pool under /usr/local/etc/php-fpm.d"],
  "no_extra_operator_flags": true,
  "expect": {
    "effective_web_runtime": "NOT_VERIFIED",
    "must_not_claim_verified_runtime": true,
    "nginx_coverage_status_in": ["PARTIAL", "INCOMPLETE", "TRUNCATED"],
    "php_fpm_coverage_status_in": ["PARTIAL", "INCOMPLETE", "TRUNCATED"],
    "evidence_any": [
      {
        "type": "nginx_php_handler_config",
        "detail_contains_all": ["unix:/run/php/php-fpm.sock", "scope=local_candidate"]
      },
      {
        "type": "php_fpm_pool_config",
        "detail_contains_all": ["listen=unix:/run/php/php-fpm.sock"]
      }
    ],
    "evidence_none_types": ["nginx_remote_php_backend"],
    "handler_and_pool_versions_empty": true,
    "forbid_soft_no_php_within_coverage": true,
    "correlation_detail_optional": "correlated_fpm_pool="
  }
}
