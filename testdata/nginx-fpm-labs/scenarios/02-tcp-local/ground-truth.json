    "evidence_any": [
      {"type": "nginx_php_handler_config", "detail_contains_all": ["127.0.0.1:9000", "scope=local_candidate"]},
      {"type": "php_fpm_pool_config", "detail_contains_all": ["listen=127.0.0.1:9000"]}
    ],
    "evidence_none_types": ["nginx_remote_php_backend"],
    "handler_and_pool_versions_empty": true,
    "forbid_soft_no_php_within_coverage": true
  }
}
